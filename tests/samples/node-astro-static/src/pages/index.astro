---
// Runs once, at build time: the page is plain HTML that nginx serves.
const builtAt = new Date().toISOString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gitberth sample</title>
  </head>
  <body>
    <h1>Hello from Astro</h1>
    <p>Built at {builtAt}.</p>
  </body>
</html>
