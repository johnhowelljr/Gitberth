# Copy to .env next to docker-compose.yml and fill in. The installer (install.sh) writes this file for you.

# Admin password for the first start (sign in as "admin"). Leave empty to have one generated
# and printed in `docker compose logs gitberth`.
GITBERTH_ADMIN_PASSWORD=

# This machine's LAN address, used for the app links Gitberth shows (e.g. 192.168.1.50).
GITBERTH_PUBLIC_HOST=

# Time zone for every time Gitberth shows, its logs and the update window, e.g. America/New_York.
TZ=UTC

# The port Gitberth's page is on (default 8080), and the image it runs (default the newest release).
#GITBERTH_PORT=8080
#GITBERTH_IMAGE=ghcr.io/johnhowelljr/gitberth:latest
