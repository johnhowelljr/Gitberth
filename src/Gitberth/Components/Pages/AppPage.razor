    // Check for update (the header, the More menu, the Updates card's Check now): asks the registry, and the card and the
    // header follow what it found at once. The card's own button says it there, not in a snackbar too.
    private async Task CheckUpdateAsync(bool quiet = false)
    {
        if (view is null || checking) return;
        checking = true;
        try
        {
            var status = await Updates.CheckAsync(view.Summary.Key);
            update = status;
            if (!quiet)
                Snackbar.Add(status.Error ?? AppOverviewTab.UpdateLine(status), status.Error is not null ? Severity.Warning : status.Available ? Severity.Info : Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            checking = false;
        }
    }

    // Update: the pull and the plan (C's), then the change dialog with that plan; Start runs it (UpdateService.Start).
    private Task UpdateAsync() => ChangeImageAsync(key => Updates.PrepareAsync(key), "Update", "There's nothing to update.");

    // Roll back: the plan back to the image kept from before the last update (nothing is pulled), through the same dialog.
    private Task RollBackAsync() => ChangeImageAsync(key => Updates.PrepareRollbackAsync(key), "Roll back", "There's nothing to roll back to.");

    private async Task ChangeImageAsync(Func<string, Task<UpdatePrepared>> prepare, string verb, string nothing)
    {
        if (view is null || busy) return;
        busy = true;
        try
        {
            var prepared = await prepare(view.Summary.Key);
            if (prepared.Blocked is { } blocked || prepared.Plan is null)
            {
                Snackbar.Add(prepared.Blocked ?? nothing, Severity.Warning);
                await LoadUpdateAsync(force: true);
                return;
            }
            var change = prepared.Plan;
            var request = change.Request;
            var opts = settings?.Options ?? new AppOptions { Name = view.Summary.Title };
            var changePlan = new SettingsPlan
            {
                Key = view.Summary.Key,
                Edit = new SettingsEdit(request?.ContainerId ?? view.Summary.ContainerId, request?.Loaded ?? settings?.Container ?? new ContainerSettings(),
                    request?.Wanted ?? settings?.Container ?? new ContainerSettings(), opts, opts),
                Lines = change.Settings,
                Change = change,
                Consequence = change.Impact.FirstOrDefault(),
                Blocked = change.Blocked,
            };
            var dialog = await Dialogs.ShowAsync<ChangeDialog>($"{verb} {view.Summary.Title}", new DialogParameters<ChangeDialog> { { x => x.Plan, changePlan } },
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
            // It runs on when the dialog is closed early: the card and Roll back follow it once it's done.
            if (await dialog.Result is { Canceled: false, Data: SettingsOutcome { Job: { } job } }) _ = FollowAsync(job);
            await ReloadAsync();
            await LoadUpdateAsync(force: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            busy = false;
        }
    }

    // Once an update or rollback is over and tidied up (the image kept for Roll back is recorded then), the page reads its
    // update status again.
    private async Task FollowAsync(PortChangeJob job)
    {
        try
        {
            await job.Completion;
            await Updates.FollowUpOf(job.Plan.Container);
        }
        catch (Exception)
        {
            // The next refresh reads it again all the same.
        }
        if (disposed) return;
        await InvokeAsync(async () =>
        {
            if (disposed) return;
            await LoadAsync();
            await LoadUpdateAsync(force: true);
            StateHasChanged();
        });
    }

    private async Task TogglePinAsync()
    {
        if (view is null) return;
        try
        {
            var current = await Catalog.OptionsAsync(view.Summary.Key);
            await Catalog.SaveOptionsAsync(view.Summary.Key, current with { Pinned = !view.Summary.Pinned });
            Snackbar.Add(view.Summary.Pinned ? $"Unpinned {view.Summary.Title}." : $"Pinned {view.Summary.Title} to the menu.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ConnectAsync()
    {
        if (view?.Details is not { } details) return;
        var dialog = await Dialogs.ShowAsync<ConnectDialog>(null, new DialogParameters<ConnectDialog>
        {
            { x => x.Name, view.Summary.Container },
            { x => x.Details, details },
            { x => x.Addresses, Addresses },
            { x => x.Network, view.Addresses?.Network },
