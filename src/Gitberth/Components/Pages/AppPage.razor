    }

    // Remove: a Git app's delete (its images and volumes are a choice); any other app's container, its volumes a choice
    // too, with the name typed in since they may hold a database.
    private async Task RemoveAsync()
    {
        if (view is null) return;
        var app = view.Summary;
        if (AppCommands.Refusal(app, ContainerAction.Remove) is { } refusal)
        {
            Snackbar.Add(refusal, Severity.Warning);
            return;
        }
        // A preview goes as its Previews tab removes it: everything of its own, noted on its parent's Activity.
        if (previewOf is { } of && view.Row is { IsPreview: true } previewRow)
        {
            var confirmed = await Dialogs.ShowMessageBoxAsync($"Remove the preview of {of.Label}?",
                $"Its container, images and volumes go{(previewRow.Domains.Count > 0 ? $", and {string.Join(", ", previewRow.Domains.Select(d => d.Hostname))} leaves the tunnel" : "")}. "
                + $"A new commit on {(of.Info.Kind == PreviewKind.PullRequest ? "the pull request" : "the branch")} makes it again.",
                yesText: "Remove", cancelText: "Cancel");
            if (confirmed != true) return;
            busy = true;
            try
            {
                await Previews.RemoveAsync(previewRow.Id);
                Snackbar.Add($"Removed the preview of {of.Label}.", Severity.Success);
                Nav.NavigateTo($"apps/{Uri.EscapeDataString(of.ParentKey)}/previews");
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
            finally
            {
                busy = false;
            }
            return;
        }
        if (app.Source == AppSource.Git && view.Row is { } row)
        {
            // With domains off, their routes stay in the tunnel until domains are on again: the dialog says which.
            var domainsOn = row.Domains.Count > 0 && await DomainService.EnabledAsync();
            var dialog = await Dialogs.ShowAsync<DeleteAppDialog>(null, new DialogParameters<DeleteAppDialog>
            {
                { d => d.AppName, app.Title },
                { d => d.Domains, row.Domains.OrderBy(d => d.Id).Select(d => d.Hostname).ToList() },
                { d => d.DomainsEnabled, domainsOn },
            });
            if (await dialog.Result is not { Canceled: false, Data: DeleteAppDialog.Choice choice }) return;
            busy = true;
            try
            {
                var report = await Actions.DeleteAsync(row.Id, choice.RemoveImages, choice.RemoveVolumes);
                Snackbar.Add(report.Notes.Any(n => n.Problem) ? $"Deleted {app.Title}. Its domains couldn't all be taken out of the tunnel yet." : $"Deleted {app.Title}.",
                    report.Notes.Any(n => n.Problem) ? Severity.Warning : Severity.Success);
                Nav.NavigateTo("apps");
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
            finally
            {
                busy = false;
            }
            return;
        }
        var volumes = view.Details?.Mounts.Where(m => m.Type == "volume").Select(m => m.Name ?? m.Source).ToList() ?? [];
        var parameters = new DialogParameters<RemoveAppDialog>
        {
            { d => d.Title, app.Title },
            { d => d.Container, app.Container },
            { d => d.Volumes, volumes },
            { d => d.Warnings, await Actions.RemoveWarningsAsync(app.Key, new RemoveOptions(false, false)) },
        };
        var confirm = await Dialogs.ShowAsync<RemoveAppDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await confirm.Result is not { Canceled: false, Data: RemoveOptions options }) return;
        busy = true;
        try
        {
            var result = await Actions.RemoveAsync(app.Key, options);
            Snackbar.Add(result.Message, result.Ok ? Severity.Success : Severity.Error);
            if (result.Ok) Nav.NavigateTo("apps");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            busy = false;
        }
    }

    // ---- A change that isn't settled ----

    private async Task DismissChangeAsync()
    {
        if (view is null) return;
        await Changer.DismissAsync(view.Summary.Container);
        await ReloadAsync();
    }

    private async Task KeepNewAsync()
    {
        if (view?.LatestChange is not { } latest) return;
        var name = view.Summary.Container;
        if (await Dialogs.ShowMessageBoxAsync($"Keep the new {name}?",
                $"The original, {latest.OldName}, is stopped and removed; its volumes stay.", yesText: "Keep the new one", cancelText: "Cancel") == true)
            await DecideAsync(() => Changer.KeepNewAsync(name));
    }

    private async Task PutBackAsync()
    {
        if (view is null) return;
        var name = view.Summary.Container;
        if (await Dialogs.ShowMessageBoxAsync($"Put the original {name} back?",
                "The new container stops and is removed; its volumes stay. The original takes its name, its restart policy and its place back.",
                yesText: "Put the original back", cancelText: "Cancel") == true)
            await DecideAsync(() => Changer.PutOriginalBackAsync(name));
    }

    private async Task DecideAsync(Func<Task<PortChangeResult>> decide)
    {
        busy = true;
        try
        {
            var result = await decide();
            Snackbar.Add(result.Message, result.Outcome switch
            {
                PortChangeOutcome.Done or PortChangeOutcome.RolledBack => Severity.Success,
                PortChangeOutcome.NothingChanged => Severity.Info,
                _ => Severity.Error,
            });
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            busy = false;
        }
    }

    public void Dispose()
    {
        disposed = true;
        timer?.Dispose();
        planDelay?.Cancel();
    }
}
