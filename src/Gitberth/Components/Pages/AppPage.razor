    // A record with no container of its own (gone, never made, or renamed outside Gitberth) can be forgotten. A Git app is
    // deleted instead, with its builds.
    private bool CanForget => view is { Row: not null } v && v.Summary.Source != AppSource.Git
        && (v.Summary.State is AppState.Missing or AppState.NotCreated || v.Summary.State == AppState.Renamed);

    /// <summary>
    /// What the banner says of an app with no container, and what Start does about it. A Git app's container is made again
    /// from its last image when that's still on this host (<paramref name="lastImage"/>), else built again from its branch.
    /// </summary>
    internal static string MissingLine(AppSummary app, bool lastImage, string? branch) => (app.State, app.Source) switch
    {
        (AppState.Missing, AppSource.Git) when lastImage => "Gitberth still has its settings and its last image. Start makes its container again from that image, without a build.",
        (AppState.Missing, AppSource.Git) => $"Gitberth still has its settings, but its last image isn't on this host any more. Start builds it again from {(branch is { Length: > 0 } b ? b : "its branch")} and deploys it.",
        (AppState.Missing, AppSource.Existing) => $"{app.Container} was removed outside Gitberth. Gitberth kept its record (its name, ports and domains); forget it if it's gone for good.",
        (AppState.Missing, _) => "Gitberth still has its settings. Create it again makes the container from them; Forget drops the record.",
        (_, AppSource.Git) => "Start it to deploy it.",
        _ => "Gitberth has its settings but never made its container. Start creates it; Forget drops the record.",
    };

    // Forget: the record and its domains go; no container, volume or image is touched.
    private async Task ForgetAsync()
    {
        if (view is not { Row: { } row } current) return;
        var app = current.Summary;
        var domains = row.Domains.OrderBy(d => d.Id).Select(d => d.Hostname).ToList();
        var what = domains.Count == 0 ? "its settings and saved ports"
            : $"its settings, saved ports and {(domains.Count == 1 ? $"its domain {domains[0]}" : $"its {domains.Count} domains ({string.Join(", ", domains)})")}, which leave the tunnel";
        var confirmed = await Dialogs.ShowMessageBoxAsync($"Forget {app.Title}?",
            $"Gitberth deletes its record: {what}. No container, volume or image is touched{(app.RenamedTo is { } other ? $", and {other} carries on as an app of its own" : "")}.",
            yesText: "Forget it", cancelText: "Cancel");
        if (confirmed != true) return;
        busy = true;
        try
        {
            var report = await Catalog.ForgetAsync(row.Id);
            var trouble = report.Notes.FirstOrDefault(n => n.Problem);
            Snackbar.Add(trouble is null ? $"Forgot {app.Title}." : $"Forgot {app.Title}. {trouble.Text}", trouble is null ? Severity.Success : Severity.Warning);
            Nav.NavigateTo(app.RenamedTo is { } renamed ? $"apps/{Uri.EscapeDataString(renamed)}" : "apps");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            busy = false;
        }
    }

    // ---- Applying settings ----

    private void DraftChanged()
    {
        // The consequence line follows the edits, a moment after the last one.
        planDelay?.Cancel();
        planDelay = new CancellationTokenSource();
        var token = planDelay.Token;
        _ = Task.Delay(450, token).ContinueWith(async t =>
        {
            if (t.IsCanceled) return;
            await InvokeAsync(async () =>
            {
                await PlanAsync();
                StateHasChanged();
            });
        }, TaskScheduler.Default);
    }

    // The Environment tab's Secret switches are saved as the app's secret names (SecretKeys; a Git app's variables carry them too).
    private SettingsEdit? Edit() => settings is null || draft is null || options is null ? null
        : new SettingsEdit(settings.ContainerId, settings.Container, draft.ToSettings(), settings.Options,
            options.ToOptions() with { SecretKeys = draft.SecretKeys(settings.Options.SecretKeys) }, settings.Git, git?.ToOptions());

    private async Task PlanAsync()
    {
        if (!Dirty || Edit() is not { } edit)
        {
            plan = null;
            return;
        }
        planning = true;
        try
        {
            plan = await SettingsService.PlanAsync(Key, edit);
            planFor = Key;
        }
        catch (Exception ex)
        {
            plan = new SettingsPlan { Key = Key, Edit = edit, Blocked = ex.Message };
        }
        finally
        {
            planning = false;
        }
    }

    private RenderFragment ApplySection() => @<text>
        @if (plan?.ComposeSnippet is { } yaml && Dirty)
        {
            <SectionCard Title="Change it in Compose" Icon="@Icons.Material.Outlined.AccountTree" Class="gb-mt" Sub="Compose created this container, so the change goes in its file">
                <p class="gb-help" style="margin-bottom:12px">Gitberth doesn't recreate a Compose service behind Compose's back. Put this in the service's section, then run the command on the host.</p>
                <CodeBlock Title="docker-compose.yml" Code="@yaml" Icon="@Icons.Material.Outlined.Description" />
                @if (plan.ComposeCommand is { } command)
                {
                    <div style="height:12px"></div>
                    <CodeBlock Title="Then run" Code="@command" Icon="@Icons.Material.Outlined.Terminal" />
                }
            </SectionCard>
        }
        @if (Dirty)
        {
            var warn = Stale;
            var problems = draft?.Problems() ?? [];
            <ApplyBar Title="@($"{Changes} unsaved {(Changes == 1 ? "change" : "changes")}")" Warn="warn" Busy="busy"
                      Sub="@(warn ? $"{view?.Summary.Title} changed since you started editing. Discard to load it as it is now." : problems.FirstOrDefault() ?? options?.NameProblem ?? plan?.Blocked ?? plan?.Problems.FirstOrDefault()?.Message ?? plan?.Consequence ?? (planning ? "Working out what applying does…" : ""))"
                      ApplyDisabled="@(problems.Count > 0 || options?.NameProblem is not null || plan?.ComposeSnippet is not null || plan?.Blocked is not null || plan?.Problems.Count > 0)"
                      OnDiscard="Discard" OnApply="ReviewAsync" ApplyText="@(plan?.NeedsConfirm == true ? "Review and apply" : "Apply")">
                <Extra>
                    @if (plan?.Blocked is { } blocked && blocked.Contains("isn't on this host", StringComparison.Ordinal) && draft is not null)
                    {
                        <Btn Icon="@Icons.Material.Outlined.CloudDownload" OnClick="PullAsync" Busy="@(pull is not null)">@(pull is { } p ? PullWords(p) : "Pull it")</Btn>
                    }
                    @if (view?.Summary.Source == AppSource.Git && settings?.Access.ViaDeploy == true && plan is { Change: null, Blocked: null } && plan.Lines.Any(l => l.How is ApplyKind.Deploy or ApplyKind.Rebuild))
                    {
                        <Btn Kind="BtnKind.Ghost" OnClick="() => ApplyAsync(ApplyTiming.NextDeploy)" Disabled="busy">Save for next deploy</Btn>
                    }
                </Extra>
            </ApplyBar>
        }
    </text>;

    // [Pull it] when the plan says the new image isn't on this host: the pull (C's ImageService), then a fresh plan.
    private PullJob? pull;

    private static string PullWords(PullJob job) =>
        job.Progress.Total > 0 ? $"Pulling {job.Progress.Current * 100 / job.Progress.Total}%" : $"Pulling {job.Progress.LayersDone}/{job.Progress.Layers}";

    private async Task PullAsync()
    {
        if (draft is null || pull is not null) return;
        var job = Images.StartPull(draft.Image.Trim(), registryId: options?.Loaded.RegistryId);
        pull = job;
        void Redraw() => _ = InvokeAsync(StateHasChanged);
        job.Changed += Redraw;
        try
        {
            var result = await job.Completion;
            Snackbar.Add(result.Ok ? $"Pulled {job.Reference}." : result.Message, result.Ok ? Severity.Success : Severity.Error);
            await PlanAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            job.Changed -= Redraw;
            pull = null;
        }
    }

    private void Discard()
    {
        if (settings is null) return;
        draft = ContainerSettingsDraft.From(settings.Container, settings.Options.SecretKeys);
        options = AppOptionsDraft.From(settings.Options);
        git = settings.Git is { } g ? GitOptionsDraft.From(g) : null;
        plan = null;
    }

    // Review and apply: a fresh plan; the change dialog for anything that touches the container, at once for the rest.
    private async Task ReviewAsync()
    {
        await PlanAsync();
        if (plan is null || !plan.CanApply)
        {
            if (plan?.Blocked is { } blocked) Snackbar.Add(blocked, Severity.Warning);
            return;
        }
        if (plan.Change is null)
        {
            await ApplyAsync(ApplyTiming.Now);
            return;
        }
        // Named as the page names it, never by its container (gb-adminer).
        var dialog = await Dialogs.ShowAsync<ChangeDialog>($"Apply changes to {view?.Summary.Title}",
            new DialogParameters<ChangeDialog> { { x => x.Plan, plan }, { x => x.Title, view?.Summary.Title } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            settings = null;
            Discard();
            await LoadAsync();
            await LoadSettingsAsync();
        }
        else await ReloadAsync();
    }

    private async Task ApplyAsync(ApplyTiming timing)
    {
        if (plan is null) return;
        busy = true;
        try
        {
            var outcome = await SettingsService.ApplyAsync(plan, timing);
            Snackbar.Add(outcome.Message, outcome.Ok ? Severity.Success : Severity.Error);
            if (outcome.Domains?.Notes.FirstOrDefault(n => n.Problem) is { } trouble) Snackbar.Add(trouble.Text, Severity.Warning);
            if (outcome.DeploymentId is int deployment && view?.Summary.AppId is int appId)
            {
                Nav.NavigateTo($"apps/{appId}/deployments/{deployment}");
                return;
            }
            if (outcome.Ok)
            {
                settings = null;
                (draft, options, git, plan) = (null, null, null, null);
                await LoadAsync();
                await LoadSettingsAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            busy = false;
        }
    }

    // ---- Actions ----

    private async Task RunAsync(ContainerAction action)
    {
        if (view is null) return;
        busy = true;
        try
        {
            if (await AppCommands.RunAsync(view.Summary, action, Actions, Containers, Dialogs, Snackbar)) await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private Task DeployAsync() => StartDeployAsync(noCache: false);

    private Task DeployWithoutCacheAsync() => StartDeployAsync(noCache: true);

