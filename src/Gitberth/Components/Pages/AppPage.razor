@page "/apps/{Key}"
@page "/apps/{Key}/{Tab}"
@implements IDisposable
@inject AppCatalog Catalog
@inject AppSettingsService SettingsService
@inject AppActions Actions
@inject ContainerService Containers
@inject AddressBook Book
@inject ContainerStatsCollector Stats
@inject RestartSchedules Restarts
@inject PortChanger Changer
@inject UpdateService Updates
@inject ImageService Images
@inject NetworkService Networks
@inject DomainService DomainService
@inject Gitberth.Previews.PreviewService Previews
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

@if (view is null)
{
    @if (notFound)
    {
        <PageTitle>Apps · Gitberth</PageTitle>
        <div class="gb-card">
            @* An old link (/apps/5) named a Git app by its number: say so, rather than look for an app called 5. *@
            @{ var oldNumber = Key.Length > 0 && Key.All(char.IsAsciiDigit); }
            <EmptyState Icon="@Icons.Material.Outlined.SearchOff" Title="@(oldNumber ? $"No app has the number {Key} any more" : $"There's no app called {Key}")">
                <ChildContent>@(oldNumber ? "Links that named an app by its number come from an older Gitberth. That app has been deleted, so this link leads nowhere now."
                    : "No container on this host has that name, and Gitberth has no app by it. It may have been removed or renamed.")</ChildContent>
                <Actions><Btn Href="apps" Icon="@Icons.Material.Outlined.GridView">All apps</Btn></Actions>
            </EmptyState>
        </div>
    }
    else
    {
        <div class="gb-skel" style="height:200px;border-radius:16px;margin-bottom:18px"></div>
        <div class="gb-skel" style="height:42px;margin-bottom:22px"></div>
        <div class="gb-skel" style="height:320px;border-radius:12px"></div>
    }
}
else
{
    var app = view.Summary;
    var logo = LogoCatalog.Resolve(app.Image, app.Container, view.Row?.DetectedKind, app.Role == ContainerRole.Self);
    <PageTitle>@app.Title · Gitberth</PageTitle>

    <nav class="gb-crumbs" aria-label="Breadcrumb">
        <a href="apps">Apps</a><SvgIcon Icon="@Icons.Material.Outlined.ChevronRight" />
        @if (previewOf is { } of)
        {
            <a href="@($"apps/{Uri.EscapeDataString(of.ParentKey)}/previews")">@of.ParentName</a><SvgIcon Icon="@Icons.Material.Outlined.ChevronRight" />
        }
        else if (familyPrefix is { } prefix)
        {
            <a href="@($"apps?q={Uri.EscapeDataString(prefix + "-")}")">@prefix-*</a><SvgIcon Icon="@Icons.Material.Outlined.ChevronRight" />
        }
        <span>@app.Title</span>
    </nav>

    <AppHero Title="@app.Title" Color="@logo.Color">
        <Logo><AppLogo Image="@app.Image" Name="@app.Container" Size="60" Kind="@view.Row?.DetectedKind" Self="@(app.Role == ContainerRole.Self)" Dim="@(!app.Running)" /></Logo>
        <Status>
            <StatusLabel State="app.State" Text="@app.StateText" Hero="true" Since="@(app.Running ? (view.Details?.StartedAt ?? app.StartedAt) : null)"
                         Detail="@(app.Running ? null : StoppedFor)" />
            @if (app.System)
            {
                <span class="gb-tag gb-tag--outline">System</span>
            }
        </Status>
        <SourceLine>@HeroMeta(app)</SourceLine>
        <Addresses>@HeroAddresses(app)</Addresses>
        <Actions>@HeroActions(app)</Actions>
        <Stats>@HeroStats(app)</Stats>
    </AppHero>

    @Banners(app)

    <TabBar Tabs="TabItems" Active="@ActiveTab" Label="@($"{app.Title}'s pages")" />

    @switch (ActiveTab)
    {
        case "environment":
            <AppEnvironmentTab View="view" Settings="settings" Draft="draft" LoadError="@settingsError" Changed="DraftChanged" />
            @ApplySection()
            break;
        case "network":
            <NetworkTab App="view" Changed="ReloadAsync" />
            break;
        case "previews":
            <AppPreviewsTab View="view" LanHost="@lanHost" />
            break;
        case "settings":
            <AppSettingsTab View="view" Settings="settings" Draft="draft" Options="options" Git="git" LoadError="@settingsError"
                            Changed="DraftChanged" OnRemove="RemoveAsync" OnSaved="ReloadAsync" />
            @ApplySection()
            break;
        case "logs":
            <ContainerLogs @key="app.Container" ContainerName="@app.Container" />
            break;
        case "activity":
            <AppActivityTab View="view" Changed="ReloadAsync" />
            break;
        default:
            <AppOverviewTab View="view" Health="Health" Settings="settings" OnConnect="ConnectAsync" HostMemory="@Stats.Current.Host?.MemoryBytes"
                            Update="update" Checking="checking" Busy="busy" OnCheck="() => CheckUpdateAsync(quiet: true)" OnRollBack="RollBackAsync" />
            break;
    }
}

@code {
    private static readonly string[] TabKeys = ["overview", "environment", "network", "previews", "settings", "logs", "activity"];

    [Parameter] public string Key { get; set; } = "";
    [Parameter] public string? Tab { get; set; }

    private AppView? view;
    private SettingsView? settings;
    private string? settingsError;
    // The form's copies, kept across tabs and refreshes until they're applied or discarded.
    private ContainerSettingsDraft? draft;
    private AppOptionsDraft? options;
    private GitOptionsDraft? git;
    private SettingsPlan? plan;
    private string? planFor;
    private bool notFound, busy, planning;
    private string lanHost = "";
    private string? loadedKey;
    private string? whyNotStart;
    // What a preview previews and of which app; null for any other app. Read once per page.
    private Gitberth.Previews.PreviewOf? previewOf;
    private int? previewOfFor;
    // A Git app whose container is gone: its last image, and whether that's still on this host (Start makes the container
    // again from it, or builds it again). Checked once each time the container goes, not on every refresh.
    private (string? Image, bool There)? lastImage;
    // The app's family in the Apps list (sample of sample-node-express), for the breadcrumb; null when it stands alone.
    private string? familyPrefix;
    private Timer? timer;
    private int refreshing;
    private string shownKey = "";
    private CancellationTokenSource? planDelay;
    // Its update status (the Updates card, the header's Update and Roll back), and what it was read for.
    private UpdateStatus? update;
    private string? updateFor;
    private bool checking, disposed;

    private string ActiveTab => Tab switch
    {
        "env" => "environment",
        "deployments" => "activity",
        // A preview's settings and variables are its parent's: it has neither tab.
        "environment" or "settings" when IsPreview => "overview",
        "previews" when !HasPreviews => "overview",
        { } t when TabKeys.Contains(t) => t,
        _ => "overview",
    };

    private bool IsPreview => view?.Row?.IsPreview == true;

    // A Git app's Previews tab (a preview has no previews of its own).
    private bool HasPreviews => view is { Summary.Source: AppSource.Git, Row: { IsPreview: false } };

    private string BaseHref => "apps/" + Uri.EscapeDataString(view?.Summary.Key ?? Key);

    private int EnvChanges => draft?.ChangedFields().Contains(SettingField.Env) == true ? Math.Max(1, draft.Env.Count(r => r.IsNew ? r.Key.Trim().Length > 0 : r.Changed)) : 0;

    private int SettingsChanges => (draft?.ChangedFields().Count(f => f != SettingField.Env) ?? 0) + (options?.Changed().Count ?? 0) + (git?.Dirty == true ? 1 : 0);

    private int Changes => SettingsChanges + (draft?.ChangedFields().Contains(SettingField.Env) == true ? 1 : 0);

    private IReadOnlyList<TabItem> TabItems =>
    [
        new("overview", "Overview", Icons.Material.Outlined.GridView, BaseHref),
        .. IsPreview ? [] : new TabItem[] { new("environment", "Environment", Icons.Material.Outlined.Key, $"{BaseHref}/environment", EnvChanges, Short: "Env") },
        new("network", "Network", Icons.Material.Outlined.Lan, $"{BaseHref}/network"),
        .. HasPreviews ? new TabItem[] { new("previews", "Previews", Icons.Material.Outlined.Preview, $"{BaseHref}/previews") } : [],
        .. IsPreview ? [] : new TabItem[] { new("settings", "Settings", Icons.Material.Outlined.Tune, $"{BaseHref}/settings", SettingsChanges) },
        new("logs", "Logs", Icons.Material.Outlined.Article, $"{BaseHref}/logs"),
        new("activity", "Activity", Icons.Material.Outlined.History, $"{BaseHref}/activity"),
    ];

    private ContainerHealth? Health => view is null ? null : Stats.Current.Containers.FirstOrDefault(c => c.Name == view.Summary.Container);

    protected override async Task OnParametersSetAsync()
    {
        // Old links: /apps/5 (a Git app's id) goes to /apps/gb-kanban, and the old tab names to the new ones.
        if (Key.Length > 0 && Key.All(char.IsAsciiDigit) && int.TryParse(Key, out var id) && await Catalog.KeyForIdAsync(id) is { } byId)
        {
            Nav.NavigateTo($"apps/{Uri.EscapeDataString(byId)}{(Tab is null ? "" : "/" + MapTab(Tab))}", replace: true);
            return;
        }
        if (Tab is "env" or "deployments")
        {
            Nav.NavigateTo($"apps/{Uri.EscapeDataString(Key)}/{MapTab(Tab)}", replace: true);
            return;
        }
        if (loadedKey != Key)
        {
            loadedKey = Key;
            (view, settings, draft, options, git, plan, notFound, settingsError) = (null, null, null, null, null, null, false, null);
            (update, updateFor) = (null, null);
            try { lanHost = await Book.LanHostAsync(Nav.BaseUri); }
            catch (Exception) { lanHost = new Uri(Nav.BaseUri).Host; }
            await LoadAsync();
            await LoadFamilyAsync();
            timer?.Dispose();
            timer = new Timer(_ =>
            {
                if (Interlocked.Exchange(ref refreshing, 1) == 1) return;
                _ = InvokeAsync(async () =>
                {
                    try
                    {
                        await LoadAsync();
                        if (ViewKey() != shownKey) StateHasChanged();
                    }
                    finally
                    {
                        Interlocked.Exchange(ref refreshing, 0);
                    }
                });
            }, null, 5000, 5000);
        }
        if (ActiveTab is "settings" or "environment" or "overview" && settings is null) await LoadSettingsAsync();
    }

    private async Task LoadFamilyAsync()
    {
        familyPrefix = null;
        if (view is null || AppGrouping.PrefixOf(view.Summary.Container) is not { } prefix || prefix == "gb") return;
        try
        {
            var list = await Catalog.ListAsync(lanHost);
            if (list.Apps.Count(a => AppGrouping.PrefixOf(a.Container) == prefix) >= AppGrouping.MinPrefixGroup) familyPrefix = prefix;
        }
        catch (Exception) { /* the breadcrumb goes straight to Apps */ }
    }

    private static string MapTab(string tab) => tab switch { "env" => "environment", "deployments" => "activity", _ => tab };

    protected override void OnAfterRender(bool firstRender) => shownKey = ViewKey();

    private async Task LoadAsync()
    {
        try
        {
            var next = await Catalog.GetAsync(Key, lanHost);
            notFound = next is null;
            view = next;
            if (next?.Row is { IsPreview: true } previewRow && previewOfFor != previewRow.Id)
            {
                previewOf = await Previews.OfAsync(previewRow.Id);
                previewOfFor = previewRow.Id;
            }
            else if (next?.Row is not { IsPreview: true }) (previewOf, previewOfFor) = (null, null);
            whyNotStart = next is { Summary.Running: false } ? await Changer.WhyNotStartAsync(next.Summary.Container) : null;
            if (next is { Summary: { State: AppState.Missing, Source: AppSource.Git }, Row: { } row })
            {
                if (lastImage?.Image != row.CurrentImage || lastImage is null) lastImage = (row.CurrentImage, await Actions.HasLastImageAsync(row));
            }
            else lastImage = null;
            // The container was recreated outside the form (or by its own apply): an unedited form follows it.
            if (next is not null && settings is not null && settings.ContainerId != next.Summary.ContainerId && !Dirty) await LoadSettingsAsync();
            await LoadUpdateAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>
    /// The update status, read again (from the last checks: no registry is asked) when what it depends on changed: the
    /// container (an update or rollback recreated it, here or by itself), the image it keeps for Roll back, its policy, or
    /// its badge (a check made anywhere). With <paramref name="force"/>, whatever changed.
    /// </summary>
    private async Task LoadUpdateAsync(bool force = false)
    {
        if (view is not { } v || v.Summary.Source == AppSource.Git || v.Summary.Role == ContainerRole.Self)
        {
            (update, updateFor) = (null, null);
            return;
        }
        // A local image's badge is worked out afresh each time it's shown (its CheckedAt is always now): its words say what changed.
        var key = string.Join('|', v.Summary.Key, v.Summary.ContainerId, v.Summary.Image, v.Row?.PreviousImage, v.Row?.UpdatePolicy, v.Summary.Update?.Available,
            v.Summary.Update?.Text, v.Summary.Origin == ImageOrigin.Local ? null : v.Summary.Update?.CheckedAt?.Ticks);
        if (!force && key == updateFor) return;
        updateFor = key;
        try { update = await Updates.StatusAsync(v.Summary.Key); }
        catch (Exception) { update = null; }
    }

    private async Task LoadSettingsAsync()
    {
        try
        {
            settings = await SettingsService.LoadAsync(Key);
            settingsError = settings is null ? "Gitberth couldn't read its settings." : null;
            if (settings is not null && !Dirty)
            {
                draft = ContainerSettingsDraft.From(settings.Container, settings.Options.SecretKeys);
                options = AppOptionsDraft.From(settings.Options);
                git = settings.Git is { } g ? GitOptionsDraft.From(g) : null;
                plan = null;
            }
        }
        catch (Exception ex)
        {
            settingsError = ex.Message;
        }
    }

    private bool Dirty => draft?.Dirty == true || options?.Dirty == true || git?.Dirty == true;

    // The container changed under the form: applying would ask for a change against settings that aren't there any more.
    private bool Stale => Dirty && settings is not null && view is not null && settings.ContainerId != view.Summary.ContainerId;

    private string ViewKey() => view is null ? $"none:{notFound}" : string.Join('|', DateTime.UtcNow.ToString("yyyyMMddHHmm", CultureInfo.InvariantCulture),
        view.Summary, string.Join(',', view.Summary.Chips.Select(c => c.Label)), view.Details?.Status, view.Details?.RestartCount, view.Details?.Health,
        view.LatestChange?.Id, view.LatestChange?.Outcome, view.LatestChange?.Notice, view.Row?.ConfigChangePending, view.Row?.RebuildPending,
        string.Join(',', (view.AppAddresses?.Addresses ?? view.Addresses?.Addresses ?? []).Select(a => $"{a.Kind}{a.Text}{a.Live}")),
        view.Git?.Deployments.FirstOrDefault()?.Status, whyNotStart, Health?.Recent.Count, Health?.Recent.LastOrDefault().Cpu.ToString("0.0", CultureInfo.InvariantCulture),
        Stale, plan?.Consequence, update?.Available, update?.Text, update?.Previous, update?.CheckedAt, lastImage?.There);

    private async Task ReloadAsync()
    {
        await LoadAsync();
        if (!Dirty) await LoadSettingsAsync();
        StateHasChanged();
    }

    // ---- The hero ----

    private string? StoppedFor => view?.Details is { Running: false, FinishedAt: { } at } && at.Year > 2000 ? Format.Ago(at) : null;

    private IReadOnlyList<Address> Addresses => view?.AppAddresses?.Addresses ?? view?.Addresses?.Addresses ?? [];

    private string? PrimaryHref => view?.AppAddresses is { } a ? AddressBook.Primary(a)
        : Addresses.FirstOrDefault(x => x.Href is not null && x.Live && x.Kind != AddressKind.HostOnly)?.Href;

    private bool IsDatabase => view is not null && (view.Summary.Role == ContainerRole.Database || ConnectionDetails.EngineOf(view.Summary.Image) is not null);

    private RenderFragment HeroMeta(AppSummary app) => @<text>
        <SourceBadge Source="app.Source" Large="true" Href="@(view?.Row is { } row && app.Source == AppSource.Git ? row.RepoWebUrl : null)" />
        @if (app.Source == AppSource.Git && view?.Row is { } r)
        {
            <span class="gb-mono">@r.RepoFullName</span>
            <span><SvgIcon Icon="@Icons.Material.Outlined.CallSplit" />@r.Branch</span>
            @if (r.Subdirectory is { } sub)
            {
                <span><SvgIcon Icon="@Icons.Material.Outlined.Folder" /><span class="gb-mono">@sub/</span></span>
            }
            @if (r.CurrentCommit is { Length: >= 7 } sha)
            {
                <span title="@LastCommitMessage"><SvgIcon Icon="@Icons.Material.Outlined.Commit" /><span class="gb-mono">@sha[..7]</span>
                    @if (LastCommitMessage is { } message)
                    {
                        <span class="gb-ellipsis" style="max-width:340px">@message</span>
                    }
                </span>
            }
        }
        else
        {
            <span class="gb-mono gb-ellipsis" style="max-width:420px" title="@(app.TagMoved ? AppOverviewTab.TagMovedNote(app.Image) : app.Image)">@app.Image</span>
            <span>@OriginText(app)</span>
            @if (view?.Details is { } d && d.ImageId.Length > 0)
            {
                <span title="@d.ImageId"><SvgIcon Icon="@Icons.Material.Outlined.Layers" /><span class="gb-mono">@ShortId(d.ImageId)</span></span>
            }
        }
        @if (app.Title != app.Container)
        {
            <span title="The container's name"><SvgIcon Icon="@Icons.Material.Outlined.ViewInAr" /><span class="gb-mono">@app.Container</span></span>
        }
        @if (view?.Details?.Labels.GetValueOrDefault("com.docker.compose.project") is { } project)
        {
            <span class="gb-tag gb-tag--outline"><SvgIcon Icon="@Icons.Material.Outlined.AccountTree" />Compose: @project</span>
        }
    </text>;

    private static string OriginText(AppSummary app) => app.Origin switch
    {
        ImageOrigin.Registry => app.Image.Contains('/') && app.Image.Split('/')[0].Contains('.') ? "from its registry" : "from Docker Hub",
        ImageOrigin.Local => "local image",
        ImageOrigin.Pinned => "pinned to one image",
        _ => "built by Gitberth",
    };

    private static bool BuiltHere(AppSummary app) => AppOverviewTab.BuiltHere(app);

    private string? LastCommitMessage => view?.Git?.Deployments.FirstOrDefault(d => d.Status == DeployStatus.Succeeded)?.CommitMessage;

    private RenderFragment HeroAddresses(AppSummary app)
    {
        var addresses = Addresses;
        var domains = addresses.Where(a => a.Kind == AddressKind.Domain).ToList();
        var web = view?.AppAddresses?.WebPort;
        var lan = addresses.Where(a => a.Kind == AddressKind.Lan).OrderBy(a => a.ContainerPort == web ? 0 : 1).FirstOrDefault();
        var own = addresses.FirstOrDefault(a => a.Kind == AddressKind.OwnLan);
        var host = addresses.FirstOrDefault(a => a.Kind == AddressKind.HostOnly);
        var inside = addresses.Where(a => a.Kind == AddressKind.Internal).OrderBy(a => a.ContainerPort == web ? 0 : 1).FirstOrDefault();
        return @<text>
            @if (domains.FirstOrDefault() is { } main)
            {
                <span>
                    <AddressValue Text="@AppFacts.Shown(main.Text)" Href="@main.Href" Big="true" Live="main.Live" />
                    @if (domains.Count > 1)
                    {
                        <span class="gb-tag gb-tag--outline">+@(domains.Count - 1) @(domains.Count == 2 ? "domain" : "domains")</span>
                    }
                </span>
            }
            @if (lan is not null)
            {
                <span><AddressValue Key="LAN" Text="@AppFacts.Shown(lan.Text)" Href="@lan.Href" Copy="@lan.Copy" ShowCopy="true" Big="@(domains.Count == 0)" Live="lan.Live" /></span>
            }
            else if (view?.Addresses?.HostNetwork == true)
            {
                <span><span class="gb-addrv-k">Network</span><span class="gb-t2" style="font-size:13px">the host's own, on any port it opens</span></span>
            }
            else if (app.Chips.Count > 0 && host is null && app.Role != ContainerRole.Self)
            {
                <span>
                    <span class="gb-addrv-k">LAN</span><span class="gb-t3" style="font-size:13px">Not published</span>
                    <Btn Size="BtnSize.Sm" Href="@($"{BaseHref}/network")" Icon="@Icons.Material.Outlined.Lan">Publish on LAN</Btn>
                </span>
            }
            @if (own is not null)
            {
                <span><AddressValue Key="Own" Text="@AppFacts.Shown(own.Text)" Href="@own.Href" Copy="@own.Copy" Live="own.Live" /></span>
            }
            @if (host is not null)
            {
                <span><AddressValue Key="Host" Text="@host.Text" Copy="@host.Copy" Live="host.Live" /></span>
            }
            @if (inside is not null)
            {
                <span><AddressValue Key="Internal" Text="@AppFacts.Shown(inside.Text)" Copy="@inside.Copy" Live="inside.Live" /></span>
            }
        </text>;
    }

    private RenderFragment HeroActions(AppSummary app) => @<text>
        @if (PrimaryHref is { } open && app.Running)
        {
            <Btn Kind="BtnKind.Primary" Href="@open" Target="_blank" Icon="@Icons.Material.Outlined.OpenInNew">Open</Btn>
        }
        else if (IsDatabase && app.Running)
        {
            <Btn Kind="BtnKind.Primary" OnClick="ConnectAsync" Icon="@Icons.Material.Outlined.Link">Connect</Btn>
        }
        else
        {
            <Btn Kind="BtnKind.Primary" Href="@($"{BaseHref}/logs")" Icon="@Icons.Material.Outlined.Article">Logs</Btn>
        }
        @if (app.Source == AppSource.Git && view?.Row is not null)
        {
            <Btn Icon="@Icons.Material.Outlined.RocketLaunch" OnClick="DeployAsync" Busy="busy" Disabled="@(app.State == AppState.Deploying)">Deploy</Btn>
        }
        else if (update?.Available ?? app.Update?.Available == true)
        {
            <Btn Icon="@Icons.Material.Outlined.CloudDownload" OnClick="UpdateAsync" Busy="busy">Update</Btn>
        }
        else if (app.Origin is ImageOrigin.Registry or ImageOrigin.Local && app.Role != ContainerRole.Self && !BuiltHere(app))
        {
            <Btn Icon="@Icons.Material.Outlined.CloudDownload" OnClick="() => CheckUpdateAsync()" Busy="@(busy || checking)">Check for update</Btn>
        }
        @if (app.Running)
        {
            <Btn IconOnly="true" Icon="@Icons.Material.Outlined.RestartAlt" Label="@($"Restart {app.Title}")" Title="Restart" OnClick="() => RunAsync(ContainerAction.Restart)" Disabled="busy" />
            @if (app.Role != ContainerRole.Self)
            {
                <Btn IconOnly="true" Icon="@Icons.Material.Outlined.Stop" Label="@($"Stop {app.Title}")" Title="Stop" OnClick="() => RunAsync(ContainerAction.Stop)" Disabled="busy" />
            }
        }
        else if (app.State is not (AppState.Deploying or AppState.Changing or AppState.NeedsDecision) && app.State != AppState.Renamed)
        {
            <Btn IconOnly="true" Icon="@Icons.Material.Outlined.PlayArrow" Label="@($"Start {app.Title}")" Title="Start" OnClick="() => RunAsync(ContainerAction.Start)" Disabled="busy" Class="gb-btn--good" />
        }
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" AriaLabel="More actions">
            <ActivatorContent>
                <button type="button" class="gb-btn gb-btn--icon" aria-label="More actions" title="More" @onclick="context.ToggleAsync"><SvgIcon Icon="@Icons.Material.Outlined.MoreHoriz" /></button>
            </ActivatorContent>
            <ChildContent>
                @if (app.Source == AppSource.Git && view?.Row is not null)
                {
                    @* For a build the cache got wrong, or a base image that moved: every step runs again. *@
                    <MudMenuItem Icon="@Icons.Material.Outlined.LayersClear" OnClick="DeployWithoutCacheAsync" Disabled="@(busy || app.State == AppState.Deploying)">Deploy without the build cache</MudMenuItem>
                }
                <MudMenuItem Icon="@(app.Pinned ? Icons.Material.Outlined.PushPin : Icons.Material.Outlined.PushPin)" OnClick="TogglePinAsync">@(app.Pinned ? "Unpin from the menu" : "Pin to the menu")</MudMenuItem>
                @if (!IsPreview)
                {
                    <MudMenuItem Icon="@Icons.Material.Outlined.DriveFileRenameOutline" Href="@($"{BaseHref}/settings#sec-general")">Rename…</MudMenuItem>
                }
                @if (app.Source != AppSource.Git && app.Role != ContainerRole.Self)
                {
                    <MudMenuItem Icon="@Icons.Material.Outlined.CloudDownload" OnClick="() => CheckUpdateAsync()">@(BuiltHere(app) ? "Check for a newer build" : "Check for update")</MudMenuItem>
                    @if (update?.Previous is { } previous)
                    {
                        <MudMenuItem Icon="@Icons.Material.Outlined.Undo" OnClick="RollBackAsync" Disabled="busy">Roll back to @previous</MudMenuItem>
                    }
                }
                <MudMenuItem Icon="@Icons.Material.Outlined.MonitorHeart" Href="@($"health#hc-title-{app.Container}")">On the Health page</MudMenuItem>
                @if (CanForget)
                {
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Outlined.Delete" IconColor="Color.Error" OnClick="ForgetAsync">Forget…</MudMenuItem>
                }
                else if (app.Role != ContainerRole.Self)
                {
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Outlined.Delete" IconColor="Color.Error" OnClick="RemoveAsync">Remove…</MudMenuItem>
                }
            </ChildContent>
        </MudMenu>
    </text>;

    private RenderFragment HeroStats(AppSummary app)
    {
        var d = view?.Details;
        var cpu = Health?.Recent.Select(p => p.Cpu).ToList() ?? [];
        var schedule = Restarts.For(app.Container);
        // A skipped commit changed nothing that runs: the last deploy is the last one that did something.
        var lastDeploy = view?.Git?.Deployments.FirstOrDefault(d => d.Status != DeployStatus.Skipped);
        return @<text>
            <HeroStat Label="Uptime" Small="@(app.Running && d?.StartedAt is { } s ? $"since {AppFacts.When(s)}" : null)">
                @(app.Running && (d?.StartedAt ?? app.StartedAt) is { } started ? AppStatus.Long(DateTime.UtcNow - started)[4..] : "Not running")
            </HeroStat>
            <HeroStat Label="CPU" Title="100% is one core">
                <Sparkline Values="cpu" Width="64" Height="16" />
                @(app.CpuPercent is double c ? AppFacts.Percent(c) : "–")
            </HeroStat>
            <HeroStat Label="Memory" Small="@(d is { MemoryLimit: > 0 } ? $"of {AppFacts.Bytes(d.MemoryLimit)}" : "no limit")">
                @(app.MemoryBytes is ulong m ? AppFacts.Bytes(m) : "–")
            </HeroStat>
            @if (lastDeploy is not null)
            {
                <HeroStat Label="Last deploy" Small="@($"{Format.Ago(lastDeploy.QueuedAt)} · {Format.TriggerInLine(lastDeploy)}")">
                    <a href="@($"apps/{lastDeploy.AppId}/deployments/{lastDeploy.Id}")" style="color:inherit">#@lastDeploy.Id</a>
                </HeroStat>
            }
            else
            {
                <HeroStat Label="Restart policy">@AppFacts.RestartWords(d?.RestartPolicy ?? settings?.Container.Restart.Name)</HeroStat>
            }
            <HeroStat Label="Scheduled restart" Small="@(schedule is null ? null : "counted from its start")">@(schedule is { } every ? $"Every {Every(every)}" : "Off")</HeroStat>
            @if (d?.Health is { } health)
            {
                <HeroStat Label="Health check" Small="@HealthCommand">@(char.ToUpperInvariant(health[0]) + health[1..])</HeroStat>
            }
            else
            {
                <HeroStat Label="Restarts" Small="by Docker">@(d?.RestartCount.ToString(CultureInfo.InvariantCulture) ?? "–")</HeroStat>
            }
        </text>;
    }

    private string? HealthCommand => settings?.Container.Health.Test is { Count: > 1 } test ? ContainerSettingsDraft.HealthText(Security.Masking.Args(test)) : null;


    private static string Every(RestartInterval every) => every.Unit switch
    {
        RestartUnit.Minutes => $"{every.Amount} min",
        RestartUnit.Hours => $"{every.Amount} h",
        _ => every.Amount == 1 ? "day" : $"{every.Amount} days",
    };

    private static string ShortId(string id) => id.StartsWith("sha256:", StringComparison.Ordinal) ? id[7..19] : id.Length > 12 ? id[..12] : id;

    // ---- Banners ----

