@* A section of a form: its title (with an info button when it has a Tip), a line on what it's for, and its fields. *@
<section class="gb-section">
    <div class="gb-section-head">
        <h3>
            @Title
            @if (Tip is not null)
            {
                <Tip Key="@Tip" />
            }
        </h3>
        @if (Description is not null)
        {
            <p>@Description</p>
        }
        @DescriptionContent
    </div>
    <div class="gb-section-body">
        @ChildContent
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? DescriptionContent { get; set; }
    /// <summary>The title's tip: its key in the catalog (Help/Tips), shown by an info button after the title.</summary>
    [Parameter] public string? Tip { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
