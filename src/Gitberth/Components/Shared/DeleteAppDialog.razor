<MudDialog>
    <TitleContent>
        <div class="gb-dialog-title">
            <MudIcon Icon="@Icons.Material.Outlined.DeleteForever" Color="Color.Error" />
            <span>Delete @AppName?</span>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            @(Compose ? "This takes down all its services (their containers and network) and deletes the deploy history and logs. It can't be undone."
                : "This stops and removes the container and deletes the deploy history and logs. It can't be undone.")
        </MudText>
        @if (Domains.Count > 0 && DomainsEnabled)
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                Its domains (@string.Join(", ", Domains)) come out of your Cloudflare Tunnel, so they can't reach whichever app gets its port next.
                DNS records you made yourself stay; ones Gitberth added are removed.
            </MudText>
        }
        else if (Domains.Count > 0)
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                Domains are turned off, so its domains (@string.Join(", ", Domains)) stay in your Cloudflare Tunnel for now. Gitberth takes them out
                when domains are turned back on, and until then no new app gets the port or name they go to.
            </MudText>
        }
        @* MudCheckBox puts data-tip on its hidden input, which covers only the box: the words carry the tip too. *@
        <MudCheckBox T="bool" @bind-Value="removeImages" Color="Color.Error" data-tip="app.delete.images"><Tip Key="app.delete.images" Focusable="false">Also delete its images</Tip></MudCheckBox>
        <MudCheckBox T="bool" @bind-Value="removeVolumes" Color="Color.Error" data-tip="app.delete.volumes"><Tip Key="app.delete.volumes" Focusable="false">Also delete its named volumes (their data is lost)</Tip></MudCheckBox>
        @if (Databases.Count > 0)
        {
            <MudText Typo="Typo.body2" Class="mt-3">
                Its databases: @string.Join(", ", Databases). Unless you tick below, their data stays where it is (a Postgres database on its server,
                a Redis's in its volume), and only Gitberth forgets them. Its previews' own databases always go, with their previews.
            </MudText>
            <MudCheckBox T="bool" @bind-Value="removeDatabases" Color="Color.Error" data-tip="app.delete.databases"><Tip Key="app.delete.databases" Focusable="false">Also delete their data</Tip></MudCheckBox>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Confirm">Delete app</MudButton>
    </DialogActions>
</MudDialog>

@code {
    public sealed record Choice(bool RemoveImages, bool RemoveVolumes, bool RemoveDatabases = false);

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string AppName { get; set; } = "";
    [Parameter] public IReadOnlyList<string> Domains { get; set; } = [];
    [Parameter] public bool DomainsEnabled { get; set; } = true;
    /// <summary>Its databases (Settings › Databases), as "the Postgres database shop on postgres".</summary>
    [Parameter] public IReadOnlyList<string> Databases { get; set; } = [];
    /// <summary>A Compose app: its whole project goes (docker compose down).</summary>
    [Parameter] public bool Compose { get; set; }

    private bool removeImages = true;
    private bool removeVolumes;
    private bool removeDatabases;

    private void Confirm() => MudDialog.Close(DialogResult.Ok(new Choice(removeImages, removeVolumes, removeDatabases)));
}
