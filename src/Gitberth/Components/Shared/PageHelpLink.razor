@implements IDisposable
@inject NavigationManager Nav
@inject HelpDocs Help

@* The small "?" by a page's title: the help docs/help.yaml's routes give for this address. Nothing when none does. *@
@if (link is not null)
{
    <a class="gb-pagehelp" href="@link.Href" aria-label="Help for this page" data-tip="help.page-link">
        <svg class="gb-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M11 18h2v-2h-2v2zm1-16C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-2.21 0-4 1.79-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.75-3 5h2c0-2.25 3-2.5 3-5 0-2.21-1.79-4-4-4z" /></svg>
    </a>
}

@code {
    private HelpLink? link;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        link = Help.ForPath(Nav.ToBaseRelativePath(Nav.Uri));
    }

    // The same page can be another address (one app's tab, then another's): the link follows it.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var next = Help.ForPath(Nav.ToBaseRelativePath(e.Location));
        if (next == link) return;
        link = next;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
