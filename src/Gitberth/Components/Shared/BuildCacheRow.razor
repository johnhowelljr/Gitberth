@inject BuildCache Cache
@inject Gitberth.Railpack.IRailpackBuildKit RailpackBuildKit
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

@* Settings › Disk: Docker's build cache, how big it is, how much of it the next cleanup takes, and clearing it (asked first, refused while a build runs). *@
<div class="gb-row gb-row--wrap" id="build-cache" style="justify-content:space-between;gap:10px 18px">
    <div class="gb-stack" style="gap:2px">
        <span class="gb-label" style="margin:0"><Tip Key="settings.deploys.build-cache">Build cache</Tip></span>
        <span class="gb-help" style="margin:0">
            @if (problem is not null)
            {
                @($"Docker didn't say how big it is: {problem.TrimEnd('.')}.")
            }
            else if (report is null)
            {
                @("Adding it up…")
            }
            else
            {
                @* The same units as the rest of Settings › Disk, the free space and its lines included. *@
                @Gitberth.Disk.DiskText.Cache(report.Usage.Bytes)
                if (Gitberth.Disk.DiskText.Stale(report.Stale, report.KeepDays) is { } stale)
                {
                    <span> @stale</span>
                }
            }
        </span>
        @if (railpack is { CacheBytes: long railpackBytes })
        {
            @* Railpack's builds keep their cache in gitberth-buildkit's own volume, not in Docker's build cache. *@
            <span class="gb-help" id="build-cache-railpack" style="margin:0">Railpack's builds (@Gitberth.Railpack.RailpackRelease.BuildKitContainer): @Gitberth.Disk.DiskText.Size(railpackBytes)</span>
        }
    </div>
    <Btn Icon="@Icons.Material.Outlined.LayersClear" OnClick="ClearAsync" Busy="busy" Disabled="busy" Tip="settings.deploys.clear-cache">Clear build cache</Btn>
</div>

@code {
    /// <summary>The days the cleanup keeps the cache no build uses: what's older is what its next run removes.</summary>
    [Parameter] public int KeepDays { get; set; } = Gitberth.Disk.DiskRules.DefaultKeepDays;

    private BuildCacheReport? report;
    private Gitberth.Railpack.RailpackBuildKitStatus? railpack;
    private string? problem;
    private bool busy;
    private int? readFor;

    protected override async Task OnParametersSetAsync()
    {
        if (readFor == KeepDays) return;
        readFor = KeepDays;
        await ReadAsync();
    }

    /// <summary>Reads the cache again: after a cleanup, say.</summary>
    public async Task RefreshAsync()
    {
        await ReadAsync();
        StateHasChanged();
    }

    private async Task ReadAsync()
    {
        try
        {
            report = await Cache.ReportAsync(KeepDays, DateTime.UtcNow);
            problem = null;
        }
        catch (Exception ex) when (ex is DockerApiException or HttpRequestException or TimeoutException or IOException or System.Text.Json.JsonException)
        {
            problem = ex.Message;
        }
        try
        {
            railpack = await RailpackBuildKit.StatusAsync(CancellationToken.None);
        }
        catch (Exception)
        {
            // Not known: no line, as when Railpack never built anything here.
            railpack = null;
        }
    }

    private async Task ClearAsync()
    {
        var size = report is null ? "" : $" ({Gitberth.Disk.DiskText.Size(report.Usage.Bytes)})";
        // gitberth-buildkit and its volume go too (BuildCache.ClearAsync): its next Railpack build makes them again, from cold.
        var railpackToo = railpack is { Exists: true } r
            ? $", and Railpack's own in {Gitberth.Railpack.RailpackRelease.BuildKitContainer}{(r.CacheBytes is long bytes ? $" ({Gitberth.Disk.DiskText.Size(bytes)})" : "")}"
            : "";
        if (await Dialogs.ShowMessageBoxAsync("Clear the build cache?",
                $"Docker deletes every app's build cache{size}{railpackToo}. Nothing that runs changes, but the next build of each app runs every step again, so it takes longer.",
                yesText: "Clear build cache", cancelText: "Cancel") != true) return;
        busy = true;
        try
        {
            var cleared = await Cache.ClearAsync();
            Snackbar.Add(cleared.Message, cleared.Ok ? Severity.Success : Severity.Warning);
            await ReadAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
