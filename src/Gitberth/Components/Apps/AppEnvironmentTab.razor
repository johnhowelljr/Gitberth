@inject AppService Apps
@inject DatabaseService Dbs
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject Gitberth.Compose.ComposeApps ComposeApps
@inject Gitberth.Templates.TemplateBuiltIns BuiltIns

@*
    The Environment tab: the container's own variables, editable, secrets masked with Show and Copy; the image's own
    folded away under "From the image" until one is edited; for a Git app, build-time marks, the GitHub variables and
    the ones Gitberth sets like Vercel. Names and values sit in a grid that wraps long ones rather than overlapping.
*@
@if (Draft is null || Settings is null)
{
    @if (LoadError is not null)
    {
        <Banner Tone="critical" Title="Its settings couldn't be read">@LoadError</Banner>
    }
    else
    {
        <div class="gb-skel" style="height:280px;border-radius:12px"></div>
    }
}
else
{
    var own = Draft.Env.Where(r => r.Original?.FromImage != true).ToList();
    var fromImage = Draft.Env.Where(r => r.Original?.FromImage == true).ToList();
    var imageOpen = showImage || fromImage.Any(r => r.Changed);
    var git = View.Summary.Source == AppSource.Git;
    var compose = View.Row?.IsCompose == true;
    <SectionCard Title="Environment" Icon="@Icons.Material.Outlined.Key" Id="sec-env" Tip="app.env"
                 Sub="@(compose ? $"What the Compose file's ${{…}} are filled with, also written to its .env for env_file: .env; build-time ones go to its builds too.{(git ? " Each is for every deploy, for production, or for previews." : "")}"
                     : git ? "Passed to the container when it starts; build-time ones to the build too. Each is for every deploy, for production, or for previews." : "Variables set on the container. Secret values stay masked; Copy copies the real one.")">
        <Actions>
            @if (Draft.EnvChanged)
            {
                <span class="gb-tag gb-tag--accent">Changed</span>
            }
        </Actions>
        <ChildContent>
            @if (ReadOnlyWhy is { } why)
            {
                <div class="gb-ro-note" style="margin-bottom:14px"><SvgIcon Icon="@Icons.Material.Outlined.Info" Size="sm" /><span>@why</span></div>
            }
            <div class="gb-envtbl" role="table" aria-label="Environment variables">
                <div class="gb-envrow gb-envrow--head" role="row"><span role="columnheader">Name</span><span role="columnheader">Value</span><span></span></div>
                @if (own.Count == 0 && fromImage.Count == 0)
                {
                    <div class="gb-envrow" role="row"><span class="gb-t3" style="grid-column:1/-1;font-size:13px">No variables yet.</span></div>
                }
                @foreach (var row in own)
                {
                    @Row(row, git)
                }
                @if (fromImage.Count > 0)
                {
                    <div class="gb-envrow gb-envrow--more" role="row">
                        <span class="gb-row" style="gap:8px"><SvgIcon Icon="@Icons.Material.Outlined.Layers" Size="sm" Class="gb-t3" /><Tip Key="app.env.from-image">@fromImage.Count from the image</Tip></span>
                        <span class="gb-mono gb-t3 gb-ellipsis" style="font-size:12px" data-tip-text="@string.Join(", ", fromImage.Select(r => r.Key))">@(imageOpen ? "Edit one to make it the container's own" : string.Join(", ", fromImage.Select(r => r.Key)))</span>
                        <Btn Kind="BtnKind.Ghost" Size="BtnSize.Sm" OnClick="() => showImage = !showImage" aria-expanded="@(imageOpen ? "true" : "false")" Disabled="@(fromImage.Any(r => r.Changed))">@(imageOpen ? "Hide" : "Show")</Btn>
                    </div>
                    @if (imageOpen)
                    {
                        @foreach (var row in fromImage)
                        {
                            @Row(row, git)
                        }
                    }
                }
            </div>
            @foreach (var problem in Draft.EnvProblems())
            {
                <div class="gb-field-error" style="margin-top:8px" role="alert">@problem</div>
            }
            <div class="gb-tbl-actions" style="margin-top:14px">
                <Btn Icon="@Icons.Material.Outlined.Add" OnClick="AddAsync" Disabled="ReadOnly">Add variable</Btn>
                <Btn Kind="BtnKind.Ghost" Icon="@Icons.Material.Outlined.ContentPaste" OnClick="PasteAsync" Disabled="ReadOnly" Tip="app.env.paste">Paste .env</Btn>
                @if (Draft.EnvChanged)
                {
                    <Btn Kind="BtnKind.Ghost" Icon="@Icons.Material.Outlined.Undo" OnClick="UndoAll">Undo every change here</Btn>
                }
            </div>
        </ChildContent>
    </SectionCard>

    @if (managed.Count > 0)
    {
        <SectionCard Title="Set by Gitberth from its databases" Icon="@GitberthIcons.Database" Class="gb-mt" Id="sec-env-databases" Tip="app.env.databases">
            <ChildContent>
                <p class="gb-help" style="margin-bottom:14px">
                    @(git ? $"Each deploy sets these from the app's own databases, over a value of the same name above or in {(View.Row is { FromGitLab: true } ? "GitLab" : "GitHub")}; masked in the log, and passed to the build as secrets."
                          : compose ? "Each deploy sets these from the app's own databases, over a value of the same name above, and each in parts too for a Compose file that wants them one by one; masked in the log."
                          : "Gitberth keeps these in the container's environment, from the app's own databases. They change only with the database.")
                </p>
                <div class="gb-envtbl" role="table" aria-label="Variables set from its databases">
                    @foreach (var m in managed)
                    {
                        <div class="gb-envrow" role="row" style="grid-template-columns:minmax(0,1fr) minmax(0,1.4fr)">
                            <span class="gb-envkey" role="cell"><span>@m.Variable</span><span class="gb-tag" data-tip="app.env.secret"><SvgIcon Icon="@Icons.Material.Filled.Lock" />Secret</span></span>
                            <span class="gb-envval" role="cell" style="font-family:var(--gb-sans)">
                                <span>From @DatabaseService.From(m)</span>
                                @if (compose)
                                {
                                    <span class="gb-t3 gb-env-parts">In parts too: <span class="gb-mono">@string.Join(", ", DatabaseUrls.PartNames(m.Variable, m.Kind))</span></span>
                                }
                            </span>
                        </div>
                    }
                </div>
                @if (Shadowed.Count > 0)
                {
                    <p class="gb-help" style="margin-top:10px">In place of the value@(Shadowed.Count == 1 ? "" : "s") above: @string.Join(", ", Shadowed). Production gets Gitberth's.</p>
                }
                <p class="gb-help" style="margin-top:6px">Its <a href="@($"{View.Summary.Href}/settings#sec-databases")">Settings › Databases</a> adds them, copies their connection strings, and removes them.</p>
            </ChildContent>
        </SectionCard>
    }

    @if (builtIns.Count > 0)
    {
        <SectionCard Title="Set by Gitberth: where it's reached" Icon="@Icons.Material.Outlined.Public" Class="gb-mt" Id="sec-env-address" Tip="app.env.where-reached">
            <ChildContent>
                <p class="gb-help" style="margin-bottom:14px">
                    Each deploy tells the app where it's reached, as its template's file asks: its main domain, or its address on the LAN without one.
                    A domain added or taken off, or a new host port, reaches it with one deploy without a build (Apply now). A variable with the same name above wins.
                </p>
                <div class="gb-envtbl" role="table" aria-label="Where it's reached">
                    @foreach (var (key, value) in builtIns)
                    {
                        <div class="gb-envrow" role="row" style="grid-template-columns:minmax(0,1fr) minmax(0,1.4fr)">
                            <span class="gb-envkey" role="cell"><span>@key</span>@if (BuiltInsOwn.Contains(key)) { <span class="gb-tag gb-tag--outline" data-tip="app.env.yours-above">Yours above</span> }</span>
                            <span class="gb-envval" role="cell"><span class="gb-mono">@value</span></span>
                        </div>
                    }
                </div>
            </ChildContent>
        </SectionCard>
    }

    @if (git && View.Row is { } row)
    {
        <div style="height:16px"></div>
        <RepoVariablesEditor Owner="@row.Owner" Repo="@row.Repo" App="@row" />
        @if (vercel is not null)
        {
            <SectionCard Title="Set by Gitberth, like on Vercel" Icon="@Icons.Material.Outlined.AutoAwesome" Class="gb-mt" Tip="app.env.vercel">
                <ChildContent>
                    @if (vercel.Off)
                    {
                        <p class="gb-help">They're turned off for this app in <a href="@($"{View.Summary.Href}/settings#sec-source")">Settings › Source</a>.</p>
                    }
                    else
                    {
                        <p class="gb-help" style="margin-bottom:14px">
                            Gitberth tells the app where it runs and what was deployed, with Vercel's names, when it runs and (except <code>VERCEL_ENV</code>
                            and Auth.js's address) while it builds. A variable with the same name set above, or in @(row.FromGitLab ? "GitLab" : "GitHub"), wins.
                        </p>
                        <div class="gb-envtbl" role="table" aria-label="Variables Gitberth sets">
                            @foreach (var v in vercel.Added.Where(v => VercelPrefix is null || !v.Key.StartsWith(VercelPrefix, StringComparison.Ordinal)))
                            {
                                <div class="gb-envrow" role="row" style="grid-template-columns:minmax(0,1fr) minmax(0,1.4fr)">
                                    <span class="gb-envkey"><span>@v.Key</span></span>
                                    <span class="gb-envval"><span>@v.Value</span></span>
                                </div>
                            }
                        </div>
                        @if (VercelPrefix is { } prefix)
                        {
                            <p class="gb-help" style="margin-top:10px">Its framework also gets each one as <code>@(prefix)VERCEL_…</code>.</p>
                        }
                        @if (vercel.Yours.Count > 0)
                        {
                            <p class="gb-help" style="margin-top:6px">Left to the app's own values: @string.Join(", ", vercel.Yours.Where(k => VercelPrefix is null || !k.StartsWith(VercelPrefix, StringComparison.Ordinal))).</p>
                        }
                    }
                </ChildContent>
            </SectionCard>
        }
    }
}

@code {
    [Parameter, EditorRequired] public AppView View { get; set; } = default!;
    [Parameter] public SettingsView? Settings { get; set; }
    [Parameter] public ContainerSettingsDraft? Draft { get; set; }
    [Parameter] public string? LoadError { get; set; }
    /// <summary>Raised after every edit, so the page's apply bar follows.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private bool showImage;
    private readonly HashSet<EnvRowDraft> revealed = [];
    private VercelView? vercel;
    private int? vercelFor;

    // The environment is a recreate-class setting: read-only when this app's settings are (Gitberth itself).
    private bool ReadOnly => Settings?.Access.ReadOnly.Contains(SettingField.Env) == true;

    private string? ReadOnlyWhy => ReadOnly ? Settings?.Access.Recreate ?? "Gitberth doesn't change this app's environment."
        : Settings?.Access.Compose is not null ? "Compose created this container: applying gives the lines for its file, and the command to run."
        : Settings?.Access.Recreate is { } refusal ? $"Gitberth won't recreate it now: {refusal.TrimEnd('.')}." : null;

    // The variables Gitberth sets from the app's own databases (Settings › Databases).
    private IReadOnlyList<ManagedDatabase> managed = [];

    // A variable set from a database: any other app's row of it is Gitberth's, shown but not edited here.
    private bool IsManaged(string key) => managed.Any(m => m.Variable == key);

    // A Git or Compose app is given its databases' variables by each deploy, over its own values of those names.
    private bool Deployed => View.Row?.Deployed == true;

    // The database variable that takes the place of the app's own value of this name at each deploy: the variable itself, or
    // for a Compose app one of its parts (DATABASE_URL_HOST…); null for none.
    private string? ReplacedBy(string key) =>
        IsManaged(key) ? key
        : View.Row?.IsCompose == true ? managed.FirstOrDefault(m => DatabaseUrls.PartNames(m.Variable, m.Kind).Contains(key))?.Variable
        : null;

    // The tab's own values a database's replaces for production: every deploy's and production's of the same name (and a
    // Compose app's of a part's).
    private IReadOnlyList<string> Shadowed => Deployed && Draft is not null
        ? Draft.Env.Where(r => !r.Removed && r.Scope != EnvScope.Preview && ReplacedBy(r.Key) is not null).Select(r => r.Key).Distinct().ToList()
        : [];

    // Where an app installed from a template is reached, as each deploy tells it (APP_URL…), the ones its file uses; and those
    // the tab has a value of its own for, which win.
    private IReadOnlyList<(string Key, string Value)> builtIns = [];

    // The variables an inline Compose app's file uses: the built-ins it asks for are among them.
    private IReadOnlySet<string> UsedByFile(AppDefinition app) =>
        Gitberth.Compose.ComposeVariables.Used(ComposeApps.YamlOf(app)).Select(v => v.Name).ToHashSet(StringComparer.Ordinal);
    private IReadOnlyList<string> BuiltInsOwn => Draft is null ? []
        : builtIns.Where(b => Draft.Env.Any(r => !r.Removed && r.Key == b.Key && r.Value.Length > 0)).Select(b => b.Key).ToList();

    protected override async Task OnParametersSetAsync()
    {
        try { managed = View.Summary.AppId is int appId ? await Dbs.RowsAsync(appId) : []; }
        catch (Exception) { managed = []; }
        try
        {
            builtIns = View.Row is { TemplateId: not null } template && await Apps.GetAsync(template.Id) is { } loaded
                ? (await BuiltIns.ForAsync(loaded)).Where(b => UsedByFile(loaded).Contains(b.Key)).ToList()
                : [];
        }
        catch (Exception) { builtIns = []; }
        if (View.Summary.Source != AppSource.Git || View.Row is not { } row || vercelFor == row.Id) return;
        vercelFor = row.Id;
        try { vercel = await Apps.VercelVariablesAsync(row); }
        catch (Exception) { vercel = null; }
    }

    private string? VercelPrefix =>
        vercel?.Added.Select(v => v.Key).FirstOrDefault(k => !k.StartsWith("VERCEL_", StringComparison.Ordinal) && k.Contains("_VERCEL_", StringComparison.Ordinal)) is { } copy
            ? copy[..copy.IndexOf("VERCEL_", StringComparison.Ordinal)]
            : null;

    private RenderFragment Row(EnvRowDraft row, bool git) => __builder =>
    {
        // Secret by the owner's marking, or by its name or a password in a URL it carries (DATABASE_URL), which it always is.
        var secret = row.IsSecret;
        var masked = secret && !revealed.Contains(row);
        // Any other app's variable set from its database is Gitberth's: shown, never edited here. A Git or Compose app's own
        // value of that name is replaced for production by the database's (a Compose app's of one of its parts too).
        var gitberths = !Deployed && !row.IsNew && row.Original?.FromImage != true && IsManaged(row.Key);
        var replacedBy = Deployed && !row.IsNew && row.Scope != EnvScope.Preview ? ReplacedBy(row.Key) : null;
        var replaced = replacedBy is not null;
        var locked = ReadOnly || gitberths;
        // The image's own untouched variables are passed on as they are; marking one makes it the container's own.
        var canMark = !row.Removed && !locked && !(row.Original?.FromImage == true && !row.Changed);
        var css =row.Removed ? "gb-envrow--gone" : row.IsNew ? "gb-envrow--new" : row.Changed ? "gb-envrow--changed" : null;
        <div class="gb-envrow @css" role="row" @key="row">
            <span class="gb-envkey" role="cell">
                @if (row.IsNew)
                {
                    <input class="gb-input gb-input--mono" value="@row.Key" placeholder="NAME" aria-label="Variable name" spellcheck="false"
                           @oninput="e => SetKey(row, e.Value?.ToString())" />
                }
                else
                {
                    <span>@row.Key</span>
                }
                @if (secret)
                {
                    <span class="gb-tag" data-tip="app.env.secret"><SvgIcon Icon="@Icons.Material.Filled.Lock" />Secret</span>
                }
                @if (row.IsNew && row.Key.Length > 0)
                {
                    <span class="gb-tag gb-tag--good">New</span>
                }
                else if (row.Original?.FromImage == true)
                {
                    <span class="gb-default-tag" data-tip="app.env.from-image">image</span>
                }
                @if (git && row.BuildTime)
                {
                    <span class="gb-tag gb-tag--accent" data-tip="app.env.build-time">Build time</span>
                }
                @if (git && row.Scope != EnvScope.All)
                {
                    <span class="gb-tag gb-tag--outline" data-tip="app.env.scope" data-tip-detail="@ScopeTitle(row.Scope)">@EnvScopes.Label(row.Scope)</span>
                }
                @if (gitberths)
                {
                    <span class="gb-tag gb-tag--accent" data-tip="app.env.set-by-gitberth">Set by Gitberth</span>
                }
                else if (replaced)
                {
                    <span class="gb-tag gb-tag--warn" data-tip="app.env.replaced" data-tip-detail="@(replacedBy == row.Key ? $"Gitberth sets {row.Key} from the app's database, so production doesn't get this value." : $"Gitberth sets {row.Key} as a part of {replacedBy}, from the app's database, so the app doesn't get this value.")">Replaced by Gitberth</span>
                }
            </span>
            <span class="gb-envval" role="cell">
                @if (row.Removed || gitberths)
                {
                    @* A database's connection string isn't edited here, so it isn't on the page either until it's shown. *@
                    <span class="@(masked ? "gb-mask" : null)">@(masked ? "••••••••••" : row.Value)</span>
                }
                else
                {
                    <input class="gb-input gb-input--mono" type="@(masked ? "password" : "text")" value="@row.Value" aria-label="@($"Value of {row.Key}")"
                           spellcheck="false" autocomplete="off" readonly="@locked" @oninput="e => SetValue(row, e.Value?.ToString())" />
                }
            </span>
            <span class="gb-envrow-actions" role="cell">
                @if (git && !row.Removed && !ReadOnly && row.Original?.FromImage != true)
                {
                    <select class="gb-input gb-input--sm" style="width:auto;margin-right:4px" aria-label="@($"Which deploys get {row.Key}")" data-tip-text="Which deploys get it"
                            value="@row.Scope" @onchange="e => SetScope(row, e.Value?.ToString())">
                        <option value="@EnvScope.All">All deploys</option>
                        <option value="@EnvScope.Production">Production</option>
                        <option value="@EnvScope.Preview">Previews</option>
                    </select>
                }
                @if (secret && !row.Removed)
                {
                    <button type="button" class="gb-iconbtn" data-tip-text="@(masked ? "Show" : "Hide")" aria-label="@($"{(masked ? "Show" : "Hide")} {row.Key}")" @onclick="() => Reveal(row)">
                        <SvgIcon Icon="@(masked ? Icons.Material.Outlined.Visibility : Icons.Material.Outlined.VisibilityOff)" />
                    </button>
                }
                <CopyButton Value="@row.Value" Label="@($"the value of {row.Key}")" />
                @if (canMark)
                {
                    <button type="button" class="gb-iconbtn gb-secretbtn @(secret ? "on" : null)" aria-pressed="@(secret ? "true" : "false")" aria-label="@($"Secret: {row.Key}")"
                            disabled="@row.AlwaysSecret" data-tip="app.env.secret-toggle" data-tip-detail="@SecretTitle(row)" @onclick="() => ToggleSecret(row)">
                        <SvgIcon Icon="@(secret ? Icons.Material.Filled.Lock : Icons.Material.Outlined.LockOpen)" />
                    </button>
                }
                @if (git && !row.Removed && !ReadOnly)
                {
                    <button type="button" class="gb-iconbtn gb-buildbtn" data-tip="app.env.build-toggle" data-tip-detail="@(row.BuildTime ? "Passed to the build now." : "Not passed to the build now.")" aria-pressed="@(row.BuildTime ? "true" : "false")"
                            aria-label="@($"Build time for {row.Key}")" @onclick="() => ToggleBuild(row)"><SvgIcon Icon="@Icons.Material.Outlined.Build" /></button>
                }
                @if (row.Changed && !row.IsNew)
                {
                    <button type="button" class="gb-iconbtn" data-tip-text="Undo" aria-label="@($"Undo {row.Key}")" @onclick="() => Undo(row)"><SvgIcon Icon="@Icons.Material.Outlined.Undo" /></button>
                }
                @if (!row.Removed && !locked)
                {
                    <button type="button" class="gb-iconbtn" data-tip-text="Remove" aria-label="@($"Remove {row.Key}")" @onclick="() => Remove(row)"><SvgIcon Icon="@Icons.Material.Outlined.Close" /></button>
                }
            </span>
        </div>
    };

    private Task SetKey(EnvRowDraft row, string? key)
    {
        row.Key = key ?? "";
        if (Security.Masking.IsSecretName(row.Key)) row.Secret = true;
        return Changed.InvokeAsync();
    }

    private Task SetValue(EnvRowDraft row, string? value)
    {
        row.Value = value ?? "";
        return Changed.InvokeAsync();
    }

    private void Reveal(EnvRowDraft row)
    {
        if (!revealed.Remove(row)) revealed.Add(row);
    }

    private Task ToggleSecret(EnvRowDraft row)
    {
        if (row.AlwaysSecret) return Task.CompletedTask;
        row.Secret = !row.Secret;
        return Changed.InvokeAsync();
    }

    private static string SecretTitle(EnvRowDraft row) =>
        row.AlwaysSecret ? "Always secret: its name or value holds a password. Masked everywhere and kept out of logs."
        : row.Secret ? "Secret: masked everywhere and kept out of logs. Click to make it a plain variable."
        : "Not secret. Click to mask it everywhere and keep it out of logs.";

    // Which deploys get it: every one, production's (the app's own container), or previews'. One name can have a value in each.
    private Task SetScope(EnvRowDraft row, string? value)
    {
        if (!Enum.TryParse<EnvScope>(value, out var scope) || scope == row.Scope) return Task.CompletedTask;
        row.Scope = scope;
        return Changed.InvokeAsync();
    }

    private static string ScopeTitle(EnvScope scope) => scope == EnvScope.Production
        ? "Only production gets it: the app's own container, not its previews. It wins over a value for every deploy with the same name."
        : "Only previews get it, not production. It wins over a value for every deploy with the same name.";

    private Task ToggleBuild(EnvRowDraft row)
    {
        row.BuildTime = !row.BuildTime;
        return Changed.InvokeAsync();
    }

    private Task Undo(EnvRowDraft row)
    {
        row.Undo();
        return Changed.InvokeAsync();
    }

    private Task Remove(EnvRowDraft row)
    {
        Draft?.RemoveEnv(row);
        return Changed.InvokeAsync();
    }

    private Task UndoAll()
    {
        Draft?.UndoEnv();
        return Changed.InvokeAsync();
    }

    private async Task AddAsync()
    {
        Draft?.AddEnv();
        await Changed.InvokeAsync();
    }

    private async Task PasteAsync()
    {
        var dialog = await Dialogs.ShowAsync<PasteEnvDialog>((string?)null, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is not { Canceled: false, Data: string text } || Draft is null) return;
        var read = Draft.PasteEnv(text);
        Snackbar.Add($"Read {read} {(read == 1 ? "variable" : "variables")}. Nothing changes until you apply.", Severity.Info);
        await Changed.InvokeAsync();
    }
}
