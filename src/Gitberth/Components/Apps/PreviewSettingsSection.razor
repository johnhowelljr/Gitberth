@using Gitberth.Previews
@inject PreviewService Previews
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

@*
    A Git app's Previews section on its Settings tab. Saved on its own (none of it touches the app's container): which
    branches and pull requests get a preview, how many run, when they go, forks, and their domains' protection. Turning
    previews off asks first, since it removes them.
*@
<SettingsSection Id="sec-previews" Title="Previews" Icon="@Icons.Material.Outlined.Preview" Changed="Dirty" Tip="app.settings.previews"
                 Description="Pull requests and branches as apps of their own, with their own address, to try before they reach production.">
    <Field Label="Previews" Tip="app.settings.previews.mode" Changed="@(mode != loaded.Mode)">
        <Seg T="PreviewMode" Options="ModeOptions" Value="mode" ValueChanged="v => mode = v" Label="Previews" />
    </Field>
    <p class="gb-help" style="margin-top:-4px">@ModeHelp</p>
    @if (mode != PreviewMode.Off)
    {
        <div class="gb-fgrid">
            <Field Label="At most running" For="set-preview-limit" Tip="app.settings.previews.limit" Changed="@(limit != loaded.Limit)" Was="@loaded.Limit.ToString(CultureInfo.InvariantCulture)"
                   OnUndo="() => limit = loaded.Limit" Help="More wait, and start when one is removed." Error="@(limit is < 1 or > 20 ? "Between 1 and 20." : null)">
                <input id="set-preview-limit" type="number" min="1" max="20" class="gb-input" @bind="limit" @bind:event="oninput" />
            </Field>
            <Field Label="Remove after (days without a new commit)" For="set-preview-days" Tip="app.settings.previews.expiry" Changed="@(days != loaded.ExpiryDays)" Was="@loaded.ExpiryDays.ToString(CultureInfo.InvariantCulture)"
                   OnUndo="() => days = loaded.ExpiryDays" Help="A closed or merged pull request, or a deleted branch, takes its preview at once." Error="@(days is < 1 or > 365 ? "Between 1 and 365." : null)">
                <input id="set-preview-days" type="number" min="1" max="365" class="gb-input" @bind="days" @bind:event="oninput" />
            </Field>
        </div>
        <div class="gb-fgrid">
            <SwitchRow Title="Also pull requests from forks" Value="forks" ValueChanged="v => forks = v" Changed="@(forks != loaded.Forks)" Tip="app.settings.previews.forks"
                       Sub="Off: only pull requests from branches of this repo get a preview." />
            <SwitchRow Title="Protect previews' domains" Value="protect" ValueChanged="v => protect = v" Changed="@(protect != loaded.Protect)" Tip="app.settings.previews.protect"
                       Sub="Visitors sign in through Cloudflare Access before they see a preview. Access is set up in Settings › Domains." />
        </div>
        <Field Label="Each preview's database" Tip="app.settings.previews.database" Changed="@(databases != loaded.Databases)">
            <Seg T="PreviewDatabaseMode" Options="DatabaseOptions" Value="databases" ValueChanged="SetDatabasesAsync" Label="Each preview's database" Class="gb-seg--wrap" />
        </Field>
        <p class="gb-help" style="margin-top:-4px">@DatabasesHelp</p>
        @if (databases != PreviewDatabaseMode.Off && view.Own.Count > 0)
        {
            <div class="gb-ro-note">
                <SvgIcon Icon="@GitberthIcons.Database" Size="sm" />
                <span>Each preview gets its own @Own(view.Own), made before its first build and dropped when it goes. Production's stays as it is.</span>
            </div>
        }
        @if (databases == PreviewDatabaseMode.CopyOfProduction)
        {
            <Banner Tone="serious" Title="Production's data, in every preview">
                A copy holds whatever production's database holds, people's personal data too, and a preview runs a pull request's code with it.
                Choose it only when everyone who can open a pull request may see that data.
            </Banner>
        }
        @if (view.Shared.Count > 0)
        {
            var shared = view.Shared;
            <Banner Tone="serious" Title="@(shared.Count == 1 ? $"{shared[0].Name} would give previews production's database" : "These would give previews production's database")">
                @PreviewDatabases.Refusal(shared, App.Name) Until then each preview's deploy stops before it builds.
            </Banner>
        }
        @if (forks)
        {
            <Banner Tone="serious" Title="Anyone's code, built and run on this server">
                Whoever opens a pull request from a fork decides what its preview builds and runs here, on your network. Turn this on only if you trust everyone who can open one.
            </Banner>
        }
    }
    <div class="gb-row" style="justify-content:flex-end;gap:8px;margin-top:14px">
        @if (Dirty)
        {
            <Btn Kind="BtnKind.Ghost" OnClick="Undo" Disabled="busy">Undo</Btn>
        }
        <Btn Kind="BtnKind.Primary" OnClick="SaveAsync" Busy="busy" Disabled="@(!Dirty || Wanted.Problem is not null)" Tip="app.settings.previews.save">Save previews</Btn>
    </div>
</SettingsSection>

@code {
    [Parameter, EditorRequired] public AppDefinition App { get; set; } = default!;
    /// <summary>Raised after a save, so the page reads the app again.</summary>
    [Parameter] public EventCallback Saved { get; set; }

    private PreviewSettings loaded = new(PreviewMode.Off, 3, 7, false, true);
    private PreviewMode mode;
    private PreviewDatabaseMode databases;
    private int limit, days;
    private bool forks, protect, busy;
    private int? loadedFor;

    private static readonly IReadOnlyList<SegOption<PreviewMode>> ModeOptions =
    [
        new(PreviewMode.Off, "Off", Tip: "app.settings.previews.off"),
        new(PreviewMode.PullRequests, "Pull requests", Tip: "app.settings.previews.prs"),
        new(PreviewMode.PullRequestsAndBranches, "Pull requests and branches", Tip: "app.settings.previews.branches"),
    ];

    private static readonly IReadOnlyList<SegOption<PreviewDatabaseMode>> DatabaseOptions =
    [
        new(PreviewDatabaseMode.Off, "None of its own", Tip: "app.settings.previews.database.none"),
        new(PreviewDatabaseMode.Empty, "An empty one", Tip: "app.settings.previews.database.empty"),
        new(PreviewDatabaseMode.CopyOfProduction, "A copy of production's", Tip: "app.settings.previews.database.copy"),
    ];

    private PreviewSettings Wanted => new(mode, limit, days, forks, protect, databases);

    private string DatabasesHelp => databases switch
    {
        PreviewDatabaseMode.Off => "Previews get no database of their own. A variable that would give them production's database stops their deploys, unless it has a value for previews on the Environment tab.",
        PreviewDatabaseMode.CopyOfProduction => "Each preview gets a database of its own on the same Postgres server, with production's data copied in when it's made; a Redis of its own starts empty.",
        _ => "Each preview gets a database of its own on the same Postgres server, empty, so its migrations make their own tables; and a Redis of its own when the app has one.",
    };

    // "database for DATABASE_URL (on postgres) and Redis for REDIS_URL".
    private static string Own(IReadOnlyList<PreviewDatabaseOf> own) => AppFacts.Names(own.Select(o => o.Kind == DatabaseKind.Redis
        ? $"Redis for {o.Variable}" : $"database for {o.Variable} (on {o.Server})").ToList());

    private bool Dirty => Wanted != loaded;

    private string ModeHelp => mode switch
    {
        PreviewMode.PullRequests => "Every open pull request gets a preview, updated with each new commit, and removed when it's closed or merged.",
        PreviewMode.PullRequestsAndBranches => $"Pull requests, and every branch other than {App.Branch} once it gets a new commit after you turn this on, so old branches aren't all built at once.",
        _ => "No previews: only production runs.",
    };

    // What previews get for their databases with the choice shown: the variables each gets its own for, and those that would
    // give them production's database, said here before a preview is refused for one.
    private PreviewDatabasesView view = PreviewDatabasesView.None;
    private PreviewDatabaseMode? viewFor;

    protected override async Task OnParametersSetAsync()
    {
        var now = PreviewSettings.Of(App);
        // Follows the app as it's saved, unless there's an edit in progress.
        if (loadedFor == App.Id && (now == loaded || Dirty)) return;
        var first = loadedFor != App.Id;
        loadedFor = App.Id;
        loaded = now;
        Undo();
        if (first || viewFor != databases) await ReadDatabasesAsync();
    }

    private async Task ReadDatabasesAsync()
    {
        viewFor = databases;
        try
        {
            view = await Previews.DatabasesAsync(App.Id, databases);
        }
        catch (Exception)
        {
            view = PreviewDatabasesView.None;
        }
    }

    private async Task SetDatabasesAsync(PreviewDatabaseMode value)
    {
        databases = value;
        await ReadDatabasesAsync();
    }

    private void Undo() => (mode, limit, days, forks, protect, databases) = (loaded.Mode, loaded.Limit, loaded.ExpiryDays, loaded.Forks, loaded.Protect, loaded.Databases);

    private async Task SaveAsync()
    {
        var wanted = Wanted;
        if (wanted.Mode == PreviewMode.Off && loaded.Mode != PreviewMode.Off && await Previews.CountAsync(App.Id) is var count and > 0)
        {
            var confirmed = await Dialogs.ShowMessageBoxAsync("Turn previews off?",
                $"{(count == 1 ? "Its preview is" : $"Its {count} previews are")} removed now, with {(count == 1 ? "its container, images, volumes and domain" : "their containers, images, volumes and domains")}.",
                yesText: "Turn off and remove", cancelText: "Cancel");
            if (confirmed != true) return;
        }
        busy = true;
        try
        {
            var saved = await Previews.SaveSettingsAsync(App.Id, wanted);
            if (saved.Problem is { } problem)
            {
                Snackbar.Add(problem, Severity.Warning);
                return;
            }
            loaded = wanted;
            // Saved, but the previews' domains didn't follow in Cloudflare yet: said, never dropped.
            if (saved.Warning is { } warning) Snackbar.Add($"Saved. {warning}", Severity.Warning);
            else Snackbar.Add(wanted.Mode == PreviewMode.Off ? "Previews are off." : "Saved. Gitberth looks at the repo again now.", Severity.Success);
            await Saved.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            busy = false;
        }
    }
}
