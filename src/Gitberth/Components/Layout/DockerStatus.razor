@implements IDisposable
@inject DockerCli Docker

@* The engine's version, or that it can't be reached; its tip says what that means, with the engine's and CLI's versions or the error. *@
<span class="gb-engine @(ok ? "gb-engine--ok" : "gb-engine--down")" data-tip="@(Tip ?? "topbar.docker")" data-tip-detail="@detail">
    <span class="gb-engine-dot"></span>@label
</span>

@code {
    /// <summary>Another tip than the top bar's (its key in the catalog).</summary>
    [Parameter] public string? Tip { get; set; }

    private bool ok = true;
    private string label = "Docker";
    private string detail = "Checking the Docker engine…";
    private Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        timer = new Timer(_ => InvokeAsync(async () =>
        {
            await RefreshAsync();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task RefreshAsync()
    {
        var info = await Docker.GetInfoAsync();
        ok = info.ServerVersion is not null;
        label = ok ? $"Docker {info.ServerVersion}" : "Docker offline";
        detail = ok ? $"Engine {info.ServerVersion}, CLI {info.ClientVersion}" : info.Error ?? "The Docker engine isn't reachable.";
    }

    public void Dispose() => timer?.Dispose();
}
